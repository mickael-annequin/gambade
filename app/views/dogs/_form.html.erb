<%= form_with model: dog, url: dog_path do |f| %>
  <% if dog.errors.any? %>
    <ul class="alert">
      <% dog.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :photo, "Photo" %>
    <%= f.file_field :photo, accept: "image/*" %>
  </div>

  <div>
    <%= f.label :name, "Nom" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :breed, "Race" %>
    <%= f.text_field :breed %>
  </div>

  <div>
    <%= f.label :birth_date, "Date de naissance" %>
    <%= f.date_field :birth_date, max: Date.current %>
  </div>

  <%= f.submit "Enregistrer" %>
<% end %>
