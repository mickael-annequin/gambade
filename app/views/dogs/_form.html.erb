<%= form_with model: dog, url: dog_path do |f| %>
  <% if dog.errors.any? %>
    <ul class="alert alert-danger">
      <% dog.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="mb-3">
    <%= f.label :photo, "Photo", class: "form-label" %>
    <%= f.file_field :photo, accept: "image/*", class: "form-control form-control-lg" %>
  </div>

  <div class="mb-3">
    <%= f.label :name, "Nom", class: "form-label" %>
    <%= f.text_field :name, class: "form-control form-control-lg" %>
  </div>

  <div class="mb-3">
    <%= f.label :breed, "Race", class: "form-label" %>
    <%= f.text_field :breed, class: "form-control form-control-lg" %>
  </div>

  <div class="mb-4">
    <%= f.label :birth_date, "Date de naissance", class: "form-label" %>
    <%= f.date_field :birth_date, max: Date.current, class: "form-control form-control-lg" %>
  </div>

  <%= f.submit "✓ Enregistrer", class: "btn btn-primary btn-lg w-100" %>
<% end %>
