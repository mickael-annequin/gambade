<div class="page-header">
  <h1>Mon chien</h1>
  <%= link_to "✏️ Modifier", edit_dog_path, class: "small-action" %>
</div>

<div class="dog-profile">
  <% if @dog.photo.attached? %>
    <%= cl_image_tag @dog.photo.key, width: 320, height: 320, crop: :fill, gravity: :auto,
                     fetch_format: :auto, quality: :auto, class: "dog-profile-photo", alt: @dog.name %>
  <% else %>
    <div class="dog-profile-photo dog-profile-photo-empty">🐶</div>
  <% end %>
  <h2><%= @dog.name %></h2>
  <p><%= dog_details(@dog) %></p>
</div>

<h2 class="section-title">Depuis le début</h2>
<div class="stat-cards">
  <div class="stat-card">
    <div class="stat-card-number"><%= walk_km(@walks.sum(:distance_meters)) %></div>
    <div class="stat-card-label">km</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-number"><%= @walks.count %></div>
    <div class="stat-card-label">balades</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-number"><%= @walks.sum(:dogs_met_count) %></div>
    <div class="stat-card-label">chiens</div>
  </div>
</div>

<div class="section-header" id="sante">
  <h2 class="section-title">Santé</h2>
  <%= link_to "Historique", cares_path, class: "small-action" %>
</div>
<ul class="encounter-list">
  <% latest = @dog.latest_cares.index_by(&:kind) %>
  <% Care::KINDS.each do |kind, info| %>
    <% next unless info[:every] %>
    <li>
      <% if latest[kind] %>
        <%= render "cares/care_card", care: latest[kind], next: true %>
      <% else %>
        <%= link_to new_care_path(kind: kind), class: "encounter-card" do %>
          <span class="item-card-icon"><%= info[:label].split.first %></span>
          <span class="encounter-text">
            <strong><%= info[:label].split(" ", 2).last %></strong>
            <span class="encounter-details encounter-details-empty">+ Noter le dernier</span>
          </span>
          <span class="encounter-chevron" aria-hidden="true">›</span>
        <% end %>
      <% end %>
    </li>
  <% end %>
</ul>
<%= link_to "+ Ajouter un soin ou une visite véto", new_care_path, class: "care-add-link" %>

<div class="section-header" id="poids">
  <h2 class="section-title">Poids</h2>
  <%= link_to "+ Pesée", new_weighing_path, class: "small-action" %>
</div>
<% if @weighings.any? %>
  <% last, previous = @weighings.last, @weighings[-2] %>
  <%= link_to weighings_path, class: "weight-summary" do %>
    <strong><%= weight(last.weight_kg) %></strong>
    <span>
      le <%= l(last.measured_on, format: "%-d %b %Y") %>
      <% if (change = weight_change(last, previous)) %> · <%= change %> depuis le <%= l(previous.measured_on, format: "%-d %b") %><% end %>
    </span>
    <span class="encounter-chevron" aria-hidden="true">›</span>
  <% end %>
  <% if @weighings.size >= 2 %>
    <div class="stats-chart"
         data-controller="weight-chart"
         data-weight-chart-points-value="<%= @weighings.map { |w| { x: w.measured_on.iso8601, y: w.weight_kg.to_f } }.to_json %>">
      <canvas data-weight-chart-target="canvas" role="img" aria-label="Courbe du poids de <%= @dog.name %>"></canvas>
    </div>
  <% end %>
<% else %>
  <%= link_to new_weighing_path, class: "encounter-card" do %>
    <span class="item-card-icon">⚖️</span>
    <span class="encounter-text">
      <strong>Combien pèse <%= @dog.name %> ?</strong>
      <span class="encounter-details encounter-details-empty">+ Noter une pesée</span>
    </span>
    <span class="encounter-chevron" aria-hidden="true">›</span>
  <% end %>
<% end %>

<div class="section-header">
  <h2 class="section-title">Ses amis</h2>
  <%= link_to "Voir le carnet", friends_path, class: "small-action" %>
</div>
<% if @best_friends.any? %>
  <ul class="encounter-list">
    <% @best_friends.each.with_index(1) do |friend, rank| %>
      <li><%= render "friends/friend_card", friend: friend, rank: rank %></li>
    <% end %>
  </ul>
<% else %>
  <p class="encounter-no-position">Pas encore d'amis : ajoute un chien au carnet depuis une rencontre.</p>
<% end %>

<%= button_to "Se déconnecter", destroy_user_session_path, method: :delete,
              class: "btn btn-outline-secondary w-100 mt-5" %>
