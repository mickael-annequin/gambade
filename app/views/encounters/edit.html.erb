<%= link_to "← Retour à la balade", walk_path(@walk) %>
<h1>Rencontre de <%= l(@encounter.met_at, format: "%Hh%M") %></h1>
<p>Tout est facultatif.</p>

<%= form_with model: @encounter, url: walk_encounter_path(@walk, @encounter) do |f| %>
  <% if @encounter.errors.any? %>
    <ul class="alert">
      <% @encounter.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :dog_name, "Nom du chien" %>
    <%= f.text_field :dog_name, placeholder: "Filou" %>
  </div>

  <div>
    <%= f.label :breed, "Race" %>
    <%= f.text_field :breed, placeholder: "Beagle" %>
  </div>

  <fieldset>
    <legend>Comment ça s'est passé ?</legend>
    <% EncountersHelper::MOODS.each do |mood, label| %>
      <%= f.radio_button :mood, mood %>
      <%= f.label "mood_#{mood}", label %>
    <% end %>
  </fieldset>

  <div>
    <%= f.label :note, "Note" %>
    <%= f.text_area :note, rows: 3, placeholder: "Très joueur, a couru après la balle…" %>
  </div>

  <%= f.submit "✓ Enregistrer" %>
<% end %>

<%= button_to "🗑️ Supprimer cette rencontre", walk_encounter_path(@walk, @encounter), method: :delete,
              form: { data: { turbo_confirm: "Supprimer cette rencontre ? (appui en trop sur « +1 chien »)" } } %>
