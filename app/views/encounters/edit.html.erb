<div class="title-row">
  <%= back_button walk_path(@walk), label: "Retour à la balade" %>
  <h1 class="walk-title">Rencontre de <%= l(@encounter.met_at, format: "%Hh%M") %></h1>
</div>
<p>Tout est facultatif.</p>

<%= form_with model: @encounter, url: walk_encounter_path(@walk, @encounter) do |f| %>
  <% if @encounter.errors.any? %>
    <ul class="alert alert-danger">
      <% @encounter.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="mb-3">
    <%= f.label :dog_name, "Nom du chien", class: "form-label" %>
    <%= f.text_field :dog_name, placeholder: "Filou", class: "form-control form-control-lg" %>
  </div>

  <div class="mb-3">
    <%= f.label :breed, "Race", class: "form-label" %>
    <%= f.text_field :breed, placeholder: "Beagle", class: "form-control form-control-lg" %>
  </div>

  <fieldset class="mb-3">
    <legend class="form-label fs-6">Comment ça s'est passé ?</legend>
    <div class="mood-buttons">
      <% EncountersHelper::MOODS.each do |mood, label| %>
        <%= f.radio_button :mood, mood, class: "btn-check" %>
        <%= f.label "mood_#{mood}", class: "btn btn-outline-primary mood-button" do %>
          <span class="mood-emoji"><%= label.split.first %></span>
          <%= label.split.drop(1).join(" ") %>
        <% end %>
      <% end %>
    </div>
  </fieldset>

  <div class="mb-4">
    <%= f.label :note, "Note", class: "form-label" %>
    <%= f.text_area :note, rows: 3, placeholder: "Très joueur, a couru après la balle…", class: "form-control" %>
  </div>

  <%= f.submit "✓ Enregistrer", class: "btn btn-primary btn-lg w-100" %>
<% end %>

<%= button_to walk_encounter_path(@walk, @encounter), method: :delete, class: "danger-button mt-3",
              form: { data: { turbo_confirm: "Supprimer cette rencontre ? (appui en trop sur « +1 chien »)" } } do %>
  🗑️ Supprimer cette rencontre
<% end %>
