<%= form_with model: weighing do |f| %>
  <% if weighing.errors.any? %>
    <ul class="alert alert-danger">
      <% weighing.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="mb-3">
    <%= f.label :weight_kg, "Poids (kg)", class: "form-label" %>
    <%= f.text_field :weight_kg, value: weighing.weight_kg&.to_s&.tr(".", ","), inputmode: "decimal",
                                 class: "form-control form-control-lg", placeholder: "24,3", autofocus: weighing.new_record? %>
  </div>

  <div class="mb-4">
    <%= f.label :measured_on, "Date", class: "form-label" %>
    <%= f.date_field :measured_on, class: "form-control form-control-lg" %>
  </div>

  <%= f.submit "✓ Enregistrer", class: "btn btn-primary btn-lg w-100" %>
<% end %>
