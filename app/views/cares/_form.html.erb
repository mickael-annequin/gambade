<%= form_with model: care do |f| %>
  <% if care.errors.any? %>
    <ul class="alert alert-danger">
      <% care.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <fieldset class="mb-3">
    <legend class="form-label fs-6">Quel soin ?</legend>
    <div class="walk-moods">
      <%= f.collection_radio_buttons :kind, Care::KINDS.map { |kind, info| [ kind, info[:label] ] }, :first, :last do |choice| %>
        <%= choice.radio_button class: "btn-check" %>
        <%= choice.label class: "btn btn-outline-primary walk-mood-button" %>
      <% end %>
    </div>
  </fieldset>

  <div class="mb-3">
    <%= f.label :given_on, "Date du soin", class: "form-label" %>
    <%= f.date_field :given_on, class: "form-control form-control-lg" %>
  </div>

  <div class="mb-3">
    <%= f.label :next_due_on, "Prochain soin", class: "form-label" %>
    <%= f.date_field :next_due_on, class: "form-control form-control-lg" %>
    <div class="form-text">Laisse vide : calculé tout seul (vaccin dans 1 an, vermifuge et anti-puces dans 3 mois).</div>
  </div>

  <div class="mb-3">
    <%= f.label :product, "Produit (facultatif)", class: "form-label" %>
    <%= f.text_field :product, class: "form-control form-control-lg", placeholder: "Milbemax, Bravecto…" %>
  </div>

  <div class="mb-4">
    <%= f.label :note, "Note (facultatif)", class: "form-label" %>
    <%= f.text_area :note, rows: 3, class: "form-control", placeholder: "Poids ce jour-là, remarque du véto…" %>
  </div>

  <%= f.submit "✓ Enregistrer", class: "btn btn-primary btn-lg w-100" %>
<% end %>
