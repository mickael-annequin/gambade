<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "Gambade" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Gambade">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#2F5D50">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# PWA: installable on the phone's home screen %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;800&display=swap" rel="stylesheet">
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.32.0/mapbox-gl.css" rel="stylesheet">
    <%# Compiled from app/assets/stylesheets/application.scss %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% show_navbar = user_signed_in? && !content_for?(:hide_nav) %>
  <body>
    <%# Bottom padding: room for the tab bar (with-navbar-bottom), or a small margin (pb-3).
        Not "py-3": its !important would override the room needed by the tab bar. %>
    <main class="container pt-3 <%= show_navbar ? "with-navbar-bottom" : "pb-3" %>">
      <% if notice %><div class="alert alert-success"><%= notice %></div><% end %>
      <% if alert %><div class="alert alert-warning"><%= alert %></div><% end %>
      <%= yield %>
    </main>

    <% if show_navbar %>
      <nav class="navbar-bottom">
        <% [ [ "🏠", "Accueil", root_path, %w[pages] ],
             [ "📋", "Balades", walks_path, %w[walks walk_trims encounters] ],
             [ "🐶", "Mon chien", dog_path, %w[dogs] ] ].each do |icon, label, path, controllers| %>
          <%= link_to path, class: ("active" if controllers.include?(controller_name)),
                            aria: { current: ("page" if controllers.include?(controller_name)) } do %>
            <span class="navbar-bottom-icon"><%= icon %></span>
            <span class="navbar-bottom-label"><%= label %></span>
          <% end %>
        <% end %>
      </nav>
    <% end %>
  </body>
</html>
