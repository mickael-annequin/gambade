<% content_for :hide_nav, true %>

<div data-controller="tracking" data-tracking-save-url-value="<%= tracked_walks_path %>">
  <p>
    <span data-tracking-target="status">🟠 Recherche du GPS…</span>
    · avec <%= current_dog.name %> 🐶
  </p>

  <div data-tracking-target="suggestion" hidden>
    <p data-tracking-target="suggestionMessage"></p>
    <button type="button" data-action="tracking#finish" data-tracking-confirm-param="false">■ Terminer</button>
    <button type="button" data-action="tracking#keepWalking">Continuer</button>
  </div>

  <p><strong data-tracking-target="duration">00:00:00</strong><br>durée</p>
  <p><strong data-tracking-target="distance">0,0 km</strong><br>distance</p>

  <button type="button" data-action="tracking#addDog">
    🐕 +1 CHIEN (<span data-tracking-target="dogsCount">0</span>)
  </button>

  <button type="button" data-tracking-target="playButton"
          data-action="tracking#toggleActivity" data-tracking-kind-param="play">🎾 JEU</button>
  <button type="button" data-tracking-target="swimButton"
          data-action="tracking#toggleActivity" data-tracking-kind-param="swim">💦 BAIGNADE</button>

  <button type="button" data-tracking-target="finishButton" data-action="tracking#finish">■ Terminer</button>
</div>
