<% content_for :hide_nav, true %>

<div class="tracking" data-controller="tracking" data-tracking-save-url-value="<%= tracked_walks_path %>">
  <div class="tracking-header">
    <span data-tracking-target="status">🟠 Recherche du GPS…</span>
    <span>avec <%= current_dog.name %> 🐶</span>
  </div>

  <%# Opens after "+1 chien": the dog is counted only with "✓ OK" (optional name and mood), or cancelled. %>
  <div class="dog-panel" data-tracking-target="dogPanel" hidden>
    <strong class="dog-panel-title" data-tracking-target="dogPanelTitle"></strong>
    <input type="text" class="form-control form-control-lg" placeholder="Son nom ? (facultatif)" maxlength="50"
           autocomplete="off" list="friend-names" data-tracking-target="dogName">
    <%# Suggestions while typing: the friends of the address book (loaded now, so they work offline). %>
    <datalist id="friend-names">
      <% current_dog.friends.order(Arel.sql("LOWER(name)")).each do |friend| %>
        <option value="<%= friend.name %>"><%= friend.breed %></option>
      <% end %>
    </datalist>
    <div class="mood-buttons">
      <% EncountersHelper::MOODS.each do |mood, label| %>
        <button type="button" class="btn btn-outline-primary mood-button" aria-pressed="false"
                data-tracking-target="moodButton" data-action="tracking#chooseMood" data-tracking-mood-param="<%= mood %>">
          <span class="mood-emoji"><%= label.split.first %></span>
          <%= label.split.drop(1).join(" ") %>
        </button>
      <% end %>
    </div>
    <div class="tracking-row">
      <button type="button" class="btn btn-outline-secondary btn-lg" data-action="tracking#cancelDog">Annuler</button>
      <button type="button" class="btn btn-primary btn-lg" data-action="tracking#confirmDog">✓ OK</button>
    </div>
  </div>

  <div class="tracking-suggestion" data-tracking-target="suggestion" hidden>
    <p data-tracking-target="suggestionMessage"></p>
    <div class="tracking-row">
      <button type="button" class="btn btn-primary btn-lg"
              data-action="tracking#finish" data-tracking-confirm-param="false">■ Terminer</button>
      <button type="button" class="btn btn-outline-secondary btn-lg" data-action="tracking#keepWalking">Continuer</button>
    </div>
  </div>

  <div class="tracking-stats">
    <div>
      <div class="tracking-number" data-tracking-target="duration">00:00:00</div>
      <div class="tracking-label">durée</div>
    </div>
    <div>
      <div class="tracking-number" data-tracking-target="distance">0,0 km</div>
      <div class="tracking-label">distance</div>
    </div>
  </div>

  <div class="tracking-buttons">
    <button type="button" class="tracking-button tracking-button-dog" data-action="tracking#addDog">
      🐕 +1 CHIEN (<span data-tracking-target="dogsCount">0</span>)
    </button>

    <%# "✕ Annuler" shows only while the phase is running: it deletes a phase started by mistake. %>
    <div class="tracking-row">
      <% [ [ "play", "🎾 JEU", "jeu" ], [ "swim", "💦 BAIGNADE", "baignade" ] ].each do |kind, label, name| %>
        <div class="tracking-activity">
          <button type="button" class="tracking-button tracking-button-<%= kind %>" data-tracking-target="<%= kind %>Button"
                  data-action="tracking#toggleActivity" data-tracking-kind-param="<%= kind %>"><%= label %></button>
          <button type="button" class="tracking-activity-cancel" data-tracking-target="<%= kind %>CancelButton" hidden
                  data-action="tracking#cancelActivity" data-tracking-kind-param="<%= kind %>"
                  aria-label="Annuler cette phase de <%= name %>">✕ Annuler</button>
        </div>
      <% end %>
    </div>

    <button type="button" class="tracking-button tracking-button-finish"
            data-tracking-target="finishButton" data-action="tracking#finish">■ Terminer</button>
  </div>
</div>
