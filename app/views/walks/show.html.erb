<% if params[:finished] %>
  <div class="finished-banner">
    <strong>Bravo ! Balade terminée 🎉</strong>
    <p>Tu peux ajouter des détails sur les chiens rencontrés, si tu veux.</p>
  </div>
<% end %>

<% photos = @walk.photos.with_attached_image.order(:taken_at, :created_at) %>
<%# The whole page is in the photo viewer: it opens from the gallery and from the map. %>
<div data-controller="photo-viewer"
     data-photo-viewer-photos-value="<%= walk_photo_viewer_items(@walk, photos).to_json %>"
     data-action="map:photo->photo-viewer#openFromMap turbo:before-cache@document->photo-viewer#close">

<div class="title-row">
  <%= back_button walks_path %>
  <h1 class="walk-title"><%= l(@walk.started_at, format: "%A %-d %B · %Hh%M").capitalize %></h1>
</div>

<div class="walk-actions">
  <%= link_to edit_walk_path(@walk), class: "walk-action" do %>
    <span class="walk-action-icon">✏️</span> <span class="walk-action-label">Modifier</span>
  <% end %>
  <% if @walk.tracked? %>
    <%= link_to edit_walk_trim_path(@walk), class: "walk-action" do %>
      <span class="walk-action-icon">✂️</span> <span class="walk-action-label">Couper la fin</span>
    <% end %>
  <% end %>
  <%= button_to walk_path(@walk), method: :delete, class: "walk-action walk-action-danger",
                form: { data: { turbo_confirm: "Supprimer cette balade ?" } } do %>
    <span class="walk-action-icon">🗑️</span> <span class="walk-action-label">Supprimer</span>
  <% end %>
</div>

<% track = @walk.track_coordinates %>
<% if track.any? %>
  <div class="walk-map"
       data-controller="map"
       data-map-api-key-value="<%= ENV["MAPBOX_API_KEY"] %>"
       data-map-center-value="<%= track.first.to_json %>"
       data-map-track-value="<%= track.to_json %>"
       data-map-encounters-value="<%= @walk.encounter_markers.to_json %>"
       data-map-activities-value="<%= @walk.activity_markers.to_json %>"
       data-map-photos-value="<%= walk_photo_markers(@walk).to_json %>">
  </div>
<% end %>

<div class="stat-cards">
  <div class="stat-card">
    <div class="stat-card-number"><%= walk_duration(@walk.duration_seconds) %></div>
    <div class="stat-card-label">durée</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-number"><%= walk_km(@walk.distance_meters) %></div>
    <div class="stat-card-label">km</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-number"><%= @walk.dogs_met_count %></div>
    <div class="stat-card-label"><%= @walk.dogs_met_count > 1 ? "chiens" : "chien" %></div>
  </div>
</div>

<% [ walk_weather(@walk), walk_play_summary(@walk), walk_swim_summary(@walk) ].compact.each do |summary| %>
  <p class="activity-summary"><%= summary %></p>
<% end %>

<div class="section-header">
  <h2 class="section-title">Notes</h2>
  <% if @walk.moods.any? || @walk.comment.present? %>
    <%= link_to "✏️ Modifier", edit_walk_notes_path(@walk), class: "small-action" %>
  <% end %>
</div>
<% if @walk.moods.any? || @walk.comment.present? %>
  <div class="walk-notes">
    <% if @walk.moods.any? %>
      <div class="walk-moods">
        <% walk_mood_labels(@walk).each do |label| %>
          <span class="walk-mood-tag"><%= label %></span>
        <% end %>
      </div>
    <% end %>
    <% if @walk.comment.present? %>
      <p class="walk-comment"><%= @walk.comment %></p>
    <% end %>
  </div>
<% else %>
  <%= link_to edit_walk_notes_path(@walk), class: "encounter-card" do %>
    <span class="item-card-icon">📝</span>
    <span class="encounter-text">
      <strong>Comment était <%= current_dog.name %> ?</strong>
      <span class="encounter-details encounter-details-empty">+ Ajouter des notes</span>
    </span>
    <span class="encounter-chevron" aria-hidden="true">›</span>
  <% end %>
<% end %>

<h2 class="section-title" id="photos">Photos</h2>
<% if photos.any? %>
  <div class="walk-photos">
    <% photos.each do |photo| %>
      <button type="button" class="walk-photo-button" aria-label="Voir la photo en grand"
              data-action="photo-viewer#open" data-photo-viewer-id-param="<%= photo.id %>">
        <%= cl_image_tag photo.image.key, width: 300, height: 300, crop: :fill, gravity: :auto,
                         class: "walk-photo", alt: "Photo de la balade", loading: "lazy" %>
      </button>
    <% end %>
  </div>
<% end %>
<%= form_with url: walk_photos_path(@walk), multipart: true, class: "photo-upload",
              data: { controller: "photo-upload" } do %>
  <label class="photo-upload-button" data-photo-upload-target="button">
    <span data-photo-upload-target="label">📸 Ajouter des photos</span>
    <%= file_field_tag "walk_photos[images][]", multiple: true, accept: "image/*", hidden: true,
                       data: { photo_upload_target: "input", action: "change->photo-upload#send" } %>
  </label>
<% end %>

<% activities = @walk.activities.in_order %>
<% if activities.any? %>
  <h2 class="section-title">Jeu et baignade</h2>
  <ul class="item-list">
    <% activities.each do |activity| %>
      <li class="item-card">
        <span class="item-card-icon"><%= activity.play? ? "🎾" : "💦" %></span>
        <span class="item-card-text">
          <strong><%= activity.play? ? "Jeu" : "Baignade" %></strong>
          <span><%= l(activity.started_at, format: "%Hh%M") %> → <%= l(activity.ended_at, format: "%Hh%M") %>
            · <%= walk_duration(activity.duration_seconds) %></span>
        </span>
        <%= button_to walk_activity_path(@walk, activity), method: :delete, class: "item-card-delete",
                      title: "Supprimer", aria: { label: "Supprimer cette phase" },
                      form: { data: { turbo_confirm: "Supprimer cette phase de #{activity.play? ? 'jeu' : 'baignade'} ?" } } do %>
          🗑️
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<% encounters = @walk.encounters.in_order %>
<% if encounters.any? %>
  <h2 class="section-title">Rencontres<%= " (facultatif)" if params[:finished] %></h2>
  <ul class="encounter-list">
    <% encounters.each.with_index(1) do |encounter, number| %>
      <li>
        <%= link_to edit_walk_encounter_path(@walk, encounter), class: "encounter-card" do %>
          <span class="encounter-number"><%= number %></span>
          <span class="encounter-text">
            <strong><%= l(encounter.met_at, format: "%Hh%M") %></strong>
            <% details = encounter_details(encounter) %>
            <span class="<%= details ? "encounter-details" : "encounter-details encounter-details-empty" %>">
              <%= details || "+ Ajouter des détails" %>
            </span>
            <% if encounter.latitude.nil? %>
              <small class="encounter-no-position">Position inconnue</small>
            <% end %>
          </span>
          <span class="encounter-chevron" aria-hidden="true">›</span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<% if params[:finished] %>
  <%= link_to "✓ C'est tout bon", walks_path, class: "btn btn-primary btn-lg w-100 mt-4" %>
<% end %>

<%# Full-screen photo viewer (<dialog>: closed with ✕ or the phone "back" gesture). %>
<dialog class="photo-viewer" data-photo-viewer-target="dialog"
        data-action="touchstart->photo-viewer#touchStart touchend->photo-viewer#touchEnd click->photo-viewer#closeOnBackground">
  <img class="photo-viewer-image" alt="Photo de la balade" data-photo-viewer-target="image">
  <button type="button" class="photo-viewer-close" aria-label="Fermer" data-action="photo-viewer#close">✕</button>
  <div class="photo-viewer-bar">
    <button type="button" class="photo-viewer-arrow" aria-label="Photo précédente"
            data-photo-viewer-target="previous" data-action="photo-viewer#previous">‹</button>
    <span class="photo-viewer-caption" data-photo-viewer-target="caption"></span>
    <button type="button" class="photo-viewer-arrow" aria-label="Photo suivante"
            data-photo-viewer-target="next" data-action="photo-viewer#next">›</button>
    <%# The address is set to the photo shown (photo_viewer_controller.js). Not "#": it would mean this page,
        and a DELETE on it would delete the whole walk. %>
    <%= button_to "🗑️", walk_photos_path(@walk), method: :delete, class: "photo-viewer-delete", title: "Supprimer cette photo",
                  form: { data: { photo_viewer_target: "deleteForm", turbo_confirm: "Supprimer cette photo ?" } } %>
  </div>
</dialog>
</div>
