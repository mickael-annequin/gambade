<% if params[:finished] %>
  <p><strong>Bravo ! Balade terminée 🎉</strong></p>
  <p>Tu peux ajouter des détails sur les chiens rencontrés, si tu veux.</p>
<% end %>

<%= link_to "← Retour", walks_path %>
<%= link_to "✏️ Modifier", edit_walk_path(@walk) %>
<% if @walk.tracked? %>
  <%= link_to "✂️ Couper la fin", edit_walk_trim_path(@walk) %>
<% end %>
<%= button_to "🗑️ Supprimer", walk_path(@walk), method: :delete,
              form: { data: { turbo_confirm: "Supprimer cette balade ?" } } %>

<h1><%= l(@walk.started_at, format: "%A %-d %B · %Hh%M").capitalize %></h1>

<% track = @walk.track_coordinates %>
<% if track.any? %>
  <div style="height: 300px"
       data-controller="map"
       data-map-api-key-value="<%= ENV["MAPBOX_API_KEY"] %>"
       data-map-center-value="<%= track.first.to_json %>"
       data-map-track-value="<%= track.to_json %>"
       data-map-encounters-value="<%= @walk.encounter_markers.to_json %>"
       data-map-activities-value="<%= @walk.activity_markers.to_json %>">
  </div>
<% end %>

<p>
  <%= walk_duration(@walk.duration_seconds) %> ·
  <%= walk_distance(@walk.distance_meters) %> ·
  <%= pluralize(@walk.dogs_met_count, "chien", plural: "chiens") %>
</p>
<% [ walk_play_summary(@walk), walk_swim_summary(@walk) ].compact.each do |summary| %>
  <p><%= summary %></p>
<% end %>

<% encounters = @walk.encounters.in_order %>
<% if encounters.any? %>
  <h2>Rencontres<%= " (facultatif)" if params[:finished] %></h2>
  <ul>
    <% encounters.each.with_index(1) do |encounter, number| %>
      <li>
        <%= link_to edit_walk_encounter_path(@walk, encounter) do %>
          <%= encounter_number(number) %> <%= l(encounter.met_at, format: "%Hh%M") %>
          · <%= encounter_details(encounter) || "+ détails" %>
          <%= "(position inconnue)" if encounter.latitude.nil? %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<% if params[:finished] %>
  <%= link_to "✓ C'est tout bon", walks_path %>
<% end %>
