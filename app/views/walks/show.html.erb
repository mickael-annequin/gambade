<% if params[:finished] %>
  <div class="finished-banner">
    <strong>Bravo ! Balade terminée 🎉</strong>
    <p>Tu peux ajouter des détails sur les chiens rencontrés, si tu veux.</p>
  </div>
<% end %>

<div class="title-row">
  <%= back_button walks_path %>
  <h1 class="walk-title"><%= l(@walk.started_at, format: "%A %-d %B · %Hh%M").capitalize %></h1>
</div>

<div class="walk-actions">
  <%= link_to edit_walk_path(@walk), class: "walk-action" do %>
    <span class="walk-action-icon">✏️</span> <span class="walk-action-label">Modifier</span>
  <% end %>
  <% if @walk.tracked? %>
    <%= link_to edit_walk_trim_path(@walk), class: "walk-action" do %>
      <span class="walk-action-icon">✂️</span> <span class="walk-action-label">Couper la fin</span>
    <% end %>
  <% end %>
  <%= button_to walk_path(@walk), method: :delete, class: "walk-action walk-action-danger",
                form: { data: { turbo_confirm: "Supprimer cette balade ?" } } do %>
    <span class="walk-action-icon">🗑️</span> <span class="walk-action-label">Supprimer</span>
  <% end %>
</div>

<% track = @walk.track_coordinates %>
<% if track.any? %>
  <div class="walk-map"
       data-controller="map"
       data-map-api-key-value="<%= ENV["MAPBOX_API_KEY"] %>"
       data-map-center-value="<%= track.first.to_json %>"
       data-map-track-value="<%= track.to_json %>"
       data-map-encounters-value="<%= @walk.encounter_markers.to_json %>"
       data-map-activities-value="<%= @walk.activity_markers.to_json %>">
  </div>
<% end %>

<div class="stat-cards">
  <div class="stat-card">
    <div class="stat-card-number"><%= walk_duration(@walk.duration_seconds) %></div>
    <div class="stat-card-label">durée</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-number"><%= walk_km(@walk.distance_meters) %></div>
    <div class="stat-card-label">km</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-number"><%= @walk.dogs_met_count %></div>
    <div class="stat-card-label"><%= @walk.dogs_met_count > 1 ? "chiens" : "chien" %></div>
  </div>
</div>

<% [ walk_play_summary(@walk), walk_swim_summary(@walk) ].compact.each do |summary| %>
  <p class="activity-summary"><%= summary %></p>
<% end %>

<% encounters = @walk.encounters.in_order %>
<% if encounters.any? %>
  <h2 class="section-title">Rencontres<%= " (facultatif)" if params[:finished] %></h2>
  <ul class="encounter-list">
    <% encounters.each.with_index(1) do |encounter, number| %>
      <li>
        <%= link_to edit_walk_encounter_path(@walk, encounter), class: "encounter-card" do %>
          <span class="encounter-number"><%= number %></span>
          <span class="encounter-text">
            <strong><%= l(encounter.met_at, format: "%Hh%M") %></strong>
            <% details = encounter_details(encounter) %>
            <span class="<%= details ? "encounter-details" : "encounter-details encounter-details-empty" %>">
              <%= details || "+ Ajouter des détails" %>
            </span>
            <% if encounter.latitude.nil? %>
              <small class="encounter-no-position">Position inconnue</small>
            <% end %>
          </span>
          <span class="encounter-chevron" aria-hidden="true">›</span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<% if params[:finished] %>
  <%= link_to "✓ C'est tout bon", walks_path, class: "btn btn-primary btn-lg w-100 mt-4" %>
<% end %>
