<h1>Mes balades</h1>
<%= link_to "+ Ajouter", new_walk_path %>

<% if @walks.empty? %>
  <p>Aucune balade pour l'instant. Ajoute la première !</p>
<% end %>

<% @walks.group_by { |walk| walk.started_at.to_date.beginning_of_month }.each do |month, walks| %>
  <h2><%= walk_month(month) %></h2>

  <% walks.each do |walk| %>
    <%= link_to walk_path(walk) do %>
      <div>
        <strong><%= walk_day(walk.started_at) %></strong> · <%= l(walk.started_at, format: "%Hh%M") %><br>
        <%= walk_distance(walk.distance_meters) %> · <%= walk_duration(walk.duration_seconds) %><br>
        🐕 <%= walk.dogs_met_count %>
      </div>
    <% end %>
  <% end %>
<% end %>
