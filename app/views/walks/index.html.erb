<div class="page-header">
  <h1>Mes balades</h1>
  <%= link_to "+ Ajouter", new_walk_path, class: "small-action" %>
</div>

<div class="walk-actions">
  <%= link_to map_walks_path, class: "walk-action" do %>
    <span class="walk-action-icon">🗺️</span> <span class="walk-action-label">Carte des trajets</span>
  <% end %>
  <%= link_to stats_path, class: "walk-action" do %>
    <span class="walk-action-icon">📊</span> <span class="walk-action-label">Statistiques</span>
  <% end %>
</div>

<% if @walks.empty? %>
  <p>Aucune balade pour l'instant. Ajoute la première !</p>
<% end %>

<% @walks.group_by { |walk| walk.started_at.to_date.beginning_of_month }.each do |month, walks| %>
  <h2 class="section-title"><%= walk_month(month) %></h2>
  <% walks.each do |walk| %>
    <%= render "walks/walk_card", walk: walk %>
  <% end %>
<% end %>
